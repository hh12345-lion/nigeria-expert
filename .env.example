# Site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://www.nigeriaexpert.com

# Google Sheets (all forms append to ONE existing tab — never creates tabs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id
# Optional. If omitted, the first tab in the spreadsheet is used.
# GOOGLE_SHEET_TAB_NAME=

# Optional: webhook notification (n8n, etc.)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Analytics & marketing (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Search engine verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
