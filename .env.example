# Contact form → Google Sheets (Sheet3 tab). Share spreadsheet with service account as Editor.
# Copy these four lines into .env.local (Next.js does NOT read this file at runtime).

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id_from_url
GOOGLE_SHEET_TAB_NAME=Sheet3

# Optional: also POST to a notification webhook (Zapier, Make, etc.)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=  # fallback if Lead_notification_url is unset
NEXT_PUBLIC_SITE_URL=https://www.africaexpertwitness.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
